# Copie para server/.env e ajuste os valores
PORT=3333
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
DB_HOST=localhost
DB_PORT=3306
DB_NAME=oficinapro
DB_USER=root
DB_PASSWORD=sua_senha
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@seudominio.com
# Integração de IA (opcional). Configure somente neste arquivo server/.env; nunca no frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Opcional: deixe vazio para usar o endpoint padrão da OpenAI.
OPENAI_API_URL=

# E-mail para recuperação de senha (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OficinaPro <nao-responda@seudominio.com>

# Gateway SaaS (implementar adaptador do provedor contratado)
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=

# Provedor fiscal contratado (não habilita emissão sem adaptador/homologação)
FISCAL_PROVIDER_NAME=
FISCAL_PROVIDER_URL=
FISCAL_PROVIDER_TOKEN=
